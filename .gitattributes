# Normalize line endings: store text as LF in the repository, check out with the platform default.
* text=auto

# Source and project files
*.cs        text diff=csharp
*.csproj    text
*.props     text
*.targets   text
*.slnx      text
*.json      text
*.xml       text
*.md        text diff=markdown
*.yml       text
*.yaml      text
*.editorconfig text
.gitignore     text eol=lf
.gitattributes text eol=lf

# Scripts: shells need LF; PowerShell keeps CRLF to match the ZeroFailed/endjin build scripts.
*.sh        text eol=lf
*.ps1       text eol=crlf
*.psm1      text eol=crlf
*.psd1      text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# NuGet lock files are generated: suppress their diffs and collapse them in GitHub PR views.
packages.lock.json text -diff linguist-generated=true

# Binary files
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.dll       binary
*.exe       binary
*.pdb       binary
*.zip       binary
*.nupkg     binary
*.snupkg    binary
*.snk       binary
*.pfx       binary
