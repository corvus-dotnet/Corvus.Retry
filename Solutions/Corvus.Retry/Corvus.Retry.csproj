<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(EndjinProjectPropsPath)" Condition="$(EndjinProjectPropsPath) != ''" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace />
    <NoWarn>RCS1089</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageDescription>Retry support for synchronous and asynchronous operations: an immutable reliability pipeline (ReliabilityPipeline) with attempt and total timeouts, result retries, a fallback, a circuit breaker and hedging; Retriable and RetryTask; and a self-restarting host for long-running tasks (ReliableTaskRunner). Pluggable retry policies and strategies, and TimeProvider for all delays.</PackageDescription>
    <PackageTags>retry;resilience;transient-fault-handling;timeout;circuit-breaker;fallback;hedging;backoff;corvus;endjin</PackageTags>
    <PackageReadmeFile>PackageReadme.md</PackageReadmeFile>
    <PackageReleaseNotes>Version 3.0 is not compatible with 2.x. See https://github.com/corvus-dotnet/Corvus.Retry/blob/main/CHANGELOG.md for the changes in each release, and https://github.com/corvus-dotnet/Corvus.Retry/blob/main/Documentation/Migrating-from-2.x-to-3.0.md for the migration guide.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <!-- A short readme for nuget.org, with absolute links; the repository README links to files nuget.org cannot show. -->
    <None Include="PackageReadme.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Endjin.RecommendedPractices.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
